{
	"name": "@supertiny99/dsh-changelog-viewer",
	"version": "0.1.0",
	"description": "DSH 版本更新日志与更新前置确认：聚合官方 Release 日志，在客户端提供独立 Changelog 浏览器；当官方发布新版本时，提供先查阅变更再决定下载升级的两阶段安全控制。",
	"type": "module",
	"main": "src/index.js",
	"author": "supertiny99",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/supertiny99/dsh-changelog-viewer.git"
	},
	"bugs": {
		"url": "https://github.com/supertiny99/dsh-changelog-viewer/issues"
	},
	"homepage": "https://github.com/supertiny99/dsh-changelog-viewer#readme",
	"exports": {
		".": "./src/index.js",
		"./client": "./dist/client.js",
		"./cordis.patch.yml": "./cordis.patch.yml",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		},
		"client": {
			"platform": "web",
			"immediately": true,
			"inject": [
				"@deepseek-ai/dsh-client-ui-conversation"
			]
		}
	},
	"engines": {
		"node": ">=20",
		"dsh": ">=0.2.1-rc.5 <0.3.0"
	},
	"keywords": [
		"dsh",
		"deepseek-harness",
		"dsh-plugin",
		"changelog",
		"release-notes",
		"updates",
		"version"
	],
	"scripts": {
		"build": "node scripts/build.mjs && node scripts/selfcheck.mjs",
		"test": "node tests/release-service.spec.mjs && node tests/test-host.mjs && node tests/test-client.mjs"
	},
	"devDependencies": {
		"esbuild": "^0.25.10"
	},
	"files": [
		"dist",
		"src",
		"cordis.patch.yml",
		"README.md",
		"LICENSE"
	]
}
